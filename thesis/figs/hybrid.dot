digraph hybrid {
  rankdir=LR;
  graph [splines=polyline, nodesep=0.5, ranksep=0.7, fontname="DejaVu Sans", bgcolor="white"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.09", penwidth=1.3];
  edge [color="#444444", arrowsize=0.85, penwidth=1.2];

  beat [label="Удар ЕКГ\n(260 відліків)", fillcolor="#f3f0e8", color="#8a7a4a"];
  feat [label="Ручні ознаки\n(35 / 70-вим.)", fillcolor="#eef3fb", color="#2c5d9b"];
  win  [label="Сире вікно\n(1–2 відведення)", fillcolor="#eef3fb", color="#2c5d9b"];
  xgb  [label="XGBoost", fillcolor="#eef3fb", color="#2c5d9b"];
  cnn  [label="1D-CNN", fillcolor="#fbeeee", color="#b03030"];
  meta [label="Мета-класифікатор\n(логістична регресія)", fillcolor="#f6e8fb", color="#7a4a8a"];
  out  [label="Клас\nN / S / V / F / Q", shape=note, fillcolor="#eaf4ec", color="#3f8a52"];

  beat -> feat; beat -> win;
  feat -> xgb; win -> cnn;
  xgb -> meta [label="  p ∈ R⁵", fontname="DejaVu Sans", fontsize=10, fontcolor="#666666"];
  cnn -> meta [label="  p ∈ R⁵", fontname="DejaVu Sans", fontsize=10, fontcolor="#666666"];
  meta -> out;

  { rank=same; feat; win; }
  { rank=same; xgb; cnn; }
}